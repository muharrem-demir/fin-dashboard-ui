# nginx configuration for the built dashboard.
#
# Rendered by docker/entrypoint.sh, which substitutes ${SERVER_PORT} — nginx does not read environment
# variables itself. The security headers, including the CSP built from the configured API URLs, are
# written by the same script to /etc/nginx/conf.d/security-headers.inc.
#
# This server serves static files only. It does not proxy the API: the browser calls the backend
# directly, which makes those requests cross-origin and puts the CORS headers squarely on the
# backend's side. The one thing this file must get right for that to work is the Content-Security-
# Policy `connect-src`, which has to name the API and WebSocket origins or the browser blocks the
# requests before CORS is even considered.
#
# Note the repeated `include` of the security headers. nginx's `add_header` does not merge: a location
# that declares even one `add_header` discards every inherited one, so a block that sets Cache-Control
# silently loses the whole security policy unless it re-includes it.

server {
    listen       ${SERVER_PORT};
    listen       [::]:${SERVER_PORT};
    server_name  _;

    root  /usr/share/nginx/html;
    index index.html;

    absolute_redirect off;

    gzip              on;
    gzip_vary         on;
    gzip_min_length   1024;
    gzip_proxied      any;
    gzip_types        text/plain text/css application/javascript application/json image/svg+xml;

    include /etc/nginx/conf.d/security-headers.inc;

    # ---- Static assets -----------------------------------------------------------------------------
    # Hashed filenames, so they can be cached indefinitely and immutably.
    location /assets/ {
        include    /etc/nginx/conf.d/security-headers.inc;
        # One directive, not `expires` as well: both emit Cache-Control and the response ends up
        # carrying it twice.
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files  $uri =404;
    }

    # Never cached: it is rewritten at container start, and a cached copy would point a promoted image
    # at the previous environment's API.
    location = /config.js {
        include    /etc/nginx/conf.d/security-headers.inc;
        add_header Cache-Control "no-store, must-revalidate" always;
    }

    location = /index.html {
        include    /etc/nginx/conf.d/security-headers.inc;
        add_header Cache-Control "no-store, must-revalidate" always;
    }

    location /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # Client-side routing: an unknown path is a React Router route, not a missing file.
    location / {
        include   /etc/nginx/conf.d/security-headers.inc;
        try_files $uri $uri/ /index.html;
    }
}
