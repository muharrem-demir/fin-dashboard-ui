# Copy to `.env` and adjust. Everything here is optional — the defaults work against a backend running
# on localhost:8080.
#
# Note the split: this file configures the *tooling* (dev server proxy, compose, container start-up).
# The application's own configuration lives in config/*.yaml, because it is environment-based rather
# than machine-based and belongs in version control.

# ---- Dev server (npm run dev) --------------------------------------------------------------------
# Where Vite proxies /api and /ws. Point this at the Java backend.
API_PROXY_TARGET=http://localhost:8080
# Defaults to API_PROXY_TARGET; set separately only if the WebSocket is served elsewhere.
# WS_PROXY_TARGET=http://localhost:8080
PORT=5173
PREVIEW_PORT=4173

# ---- Build ---------------------------------------------------------------------------------------
# Selects which config/config.<mode>.yaml is baked into the bundle.
# BUILD_MODE=production

# These override the YAML at build time, for CI or a container build.
# APP_NAME=Fin Dashboard
# APP_ENVIRONMENT_LABEL=STAGING
# APP_API_BASE_URL=/api/v1
# APP_API_TIMEOUT_MS=15000
# APP_WS_URL=/ws/quotes
# APP_LOG_LEVEL=warn

# ---- docker compose ------------------------------------------------------------------------------
UI_PORT=3000
API_PORT=8080
# Where nginx inside the UI container forwards /api and /ws.
API_UPSTREAM=http://api:8080
# Path to the backend checkout, used to build the api service.
API_CONTEXT=../../java/fin-dashboard

# ---- Backend (passed through to the api and postgres services) -----------------------------------
SPRING_PROFILES_ACTIVE=dev
DB_NAME=fin_dashboard
DB_USERNAME=dashboard
DB_PASSWORD=dashboard
# How often the backend fetches and pushes subscribed quotes.
QUOTES_STREAM_INTERVAL_MS=3000
QUOTES_STREAM_ALLOWED_ORIGINS=*
