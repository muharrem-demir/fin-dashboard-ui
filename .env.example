# Copy to `.env` and adjust. Everything here is optional — the defaults work against a backend running
# on localhost:8080.
#
# Note the split: this file configures the *tooling* (dev server, container start-up). The
# application's own configuration lives in config/*.yaml, because it is environment-based rather than
# machine-based and belongs in version control.
#
# The browser calls the API directly — nothing is proxied — so every URL here must be reachable from
# the browser, and the backend must allow this app's origin via CORS.

# ---- Dev server (npm run dev) --------------------------------------------------------------------
PORT=5173
PREVIEW_PORT=4173

# ---- Where the API is ----------------------------------------------------------------------------
# Override the values baked in from config/config.default.yaml. Set these before `npm run dev` or
# `npm run build` to point the app at a backend other than localhost:8080.
# APP_API_BASE_URL=http://localhost:8080/api/v1
# APP_WS_URL=ws://localhost:8080/ws/quotes

# ---- Other build-time overrides ------------------------------------------------------------------
# Selects which config/config.<mode>.yaml is baked into the bundle.
# BUILD_MODE=production
# APP_NAME=Fin Dashboard
# APP_ENVIRONMENT_LABEL=STAGING
# APP_API_TIMEOUT_MS=15000
# APP_LOG_LEVEL=warn

# ---- docker compose ------------------------------------------------------------------------------
UI_PORT=3000
# The container reads APP_API_BASE_URL / APP_WS_URL at start-up and writes them into /config.js, so a
# built image can be repointed without a rebuild. They must be reachable from the browser, not just
# from inside the compose network.
# APP_API_BASE_URL=http://localhost:8080/api/v1
# APP_WS_URL=ws://localhost:8080/ws/quotes
