{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run lint)",
      "Bash(npm run lint:fix)",
      "Bash(npm run typecheck)",
      "Bash(npm run test)",
      "Bash(npm run test:coverage)",
      "Bash(npm run test -- *)",
      "Bash(npm run format)",
      "Bash(npm run format:check)",
      "Bash(npm run build)",
      "Bash(npm run build:only)",
      "Bash(npm run verify)",
      "Bash(npx tsc --build*)",
      "Bash(npx jest*)",
      "Bash(npx eslint*)",
      "Bash(npx prettier*)",
      "Bash(git status)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git branch*)",
      "Bash(curl -s http://localhost:8080/*)",
      "Bash(curl -fsS http://localhost:8080/*)"
    ],
    "ask": [
      "Bash(npm install*)",
      "Bash(npm uninstall*)",
      "Bash(docker compose*)",
      "Bash(git push*)",
      "Bash(git commit*)"
    ],
    "deny": ["Read(./.env)", "Read(./.env.*)"]
  }
}
